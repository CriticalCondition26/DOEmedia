# =============================================================
# Doe Media Creative Strategy Engine — Environment Variables
# =============================================================
# Copy this file to .env.local and fill in your values.
# For Vercel deployment, set these in the Vercel dashboard
# under Settings → Environment Variables.
# =============================================================

# --- Database (PostgreSQL) ---
# Sign up at https://neon.tech (free tier works)
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=

# --- Redis (for BullMQ background workers) ---
# Sign up at https://upstash.com (free tier) or use Railway
# Only needed for the workers process, not the web app
REDIS_URL=redis://localhost:6379

# --- Meta Marketing API ---
# Create a Meta app at https://developers.facebook.com
# Required: Marketing API access (standard or advanced)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=https://your-domain.com/api/meta/callback

# --- AI: Anthropic (Claude) ---
# Get your API key at https://console.anthropic.com
# Used for: ad copy (Opus), strategy + analysis (Sonnet)
ANTHROPIC_API_KEY=

# --- AI: Google (Gemini) ---
# Get your API key at https://aistudio.google.com/apikey
# Used for: video ad analysis, visual concept generation
GOOGLE_AI_API_KEY=

# --- Authentication (NextAuth v5) ---
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=https://your-domain.com

# Google OAuth credentials (for team login)
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional: restrict login to your company domain
ALLOWED_EMAIL_DOMAIN=doemedia.com

# --- Encryption ---
# For encrypting Meta API tokens stored in the database
# Generate: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# --- Alert Notifications ---
# Default Slack webhook for alerts (per-client overrides in alert_preferences)
# Create at https://api.slack.com/messaging/webhooks
SLACK_ALERTS_WEBHOOK_URL=

# Email notifications (future: configure Resend, SendGrid, or AWS SES)
# RESEND_API_KEY=
